PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Railway: https://project-deploy-985df3.netlify.app
# Para ambos: http://localhost:5173,https://project-deploy-985df3.netlify.app
# Railway: set DATABASE_URL to a reference to Auth's own PostgreSQL service.
# When present it takes precedence over DB_*. Otherwise keep the DB_* variables.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5433
DB_USER=auth_user
DB_PASSWORD=replace-with-a-local-auth-database-password
DB_NAME=auth_db
JWT_SECRET=replace-with-the-same-secret-used-by-kahoot-api
JWT_AUDIENCE=kahoot-api
JWT_ISSUER=
DEMO_USER_USERNAME=profesor_test
DEMO_USER_PASSWORD=Profesor123!

# Grafana Cloud: configurar el endpoint y encabezado como secretos en Railway.
OTEL_SERVICE_NAME=profelink-auth
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_DEPLOYMENT_ENVIRONMENT=local
